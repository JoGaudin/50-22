APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Hôte principal (web + assets Vite). Doit correspondre à l’URL du navigateur (sinon CORS sur /build/*).
# Docker + Traefik : http://${APP_SLUG}.localhost — php artisan serve : http://127.0.0.1:8000
APP_URL=http://localhost

# Sous-domaine local sans TLD (ex. boilerplate → boilerplate.localhost, api.boilerplate.localhost)
APP_SLUG=app

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
# En prod (Neon) : remplacer host/user/password/database par la connection string Neon
# et ajouter DB_SSLMODE=require (Neon exige TLS)

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# En prod (Railway, stockage éphémère) : s3, avec un bucket Cloudflare R2 (voir variables AWS_* plus bas)
# En local sans worker : sync (sinon les notifications ShouldQueue restent dans jobs). Prod : database/redis + queue:work
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En Docker : pointez vers le service MailHog (voir docker-compose.yml)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (disk s3, utilisé quand FILESYSTEM_DISK=s3) :
# AWS_ACCESS_KEY_ID/SECRET = R2 API token, AWS_DEFAULT_REGION=auto,
# AWS_ENDPOINT = https://<account_id>.r2.cloudflarestorage.com, AWS_USE_PATH_STYLE_ENDPOINT=true,
# AWS_URL = URL publique du bucket (domaine r2.dev ou domaine custom)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Sanctum / cookies (optionnel avec sous-domaines locaux)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,${APP_SLUG}.localhost,.${APP_SLUG}.localhost

# --- Docker Compose (copier ces valeurs dans .env lorsque vous utilisez make up) ---
# DB_HOST=postgres
# APP_URL=http://${APP_SLUG}.localhost
# MAIL_HOST=mailhog
# MAIL_PORT=1025
# Les variables DB_DATABASE, DB_USERNAME, DB_PASSWORD doivent correspondre à celles du service postgres dans docker-compose.yml (par défaut : laravel / laravel / secret).
