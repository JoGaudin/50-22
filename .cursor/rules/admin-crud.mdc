## 6. Page Vue (`resources/js/Pages/Admin/{Resources}/Index.vue`)

Utiliser les composants réutilisables du projet :

```vue
<script setup lang="ts">
import AdminSubnav from '@/Components/AdminSubnav.vue';
import ConfirmActionDialog from '@/Components/ConfirmActionDialog.vue';
import Drawer from '@/Components/Drawer.vue';
import FlashMessages from '@/Components/FlashMessages.vue';
import FormField from '@/Components/FormField.vue';
import LoadingButton from '@/Components/LoadingButton.vue';
import PageHeader from '@/Components/PageHeader.vue';
import { Button } from '@/Components/ui/button';
import { Input } from '@/Components/ui/input';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/Components/ui/table';
import { useInertiaForm } from '@/composables/useInertiaForm';
import AuthenticatedLayout from '@/Layouts/AuthenticatedLayout.vue';
import { Head, router } from '@inertiajs/vue3';

const props = defineProps<{ items: Array<{ id: number; name: string }> }>();

const { form, drawerOpen, editingId, openCreate, openEdit, submit } = useInertiaForm({ name: '' });

function submitCreate() {
    submit(route('admin.{resources}.store'), 'post');
}

function submitEdit() {
    if (!editingId.value) return;
    submit(route('admin.{resources}.update', editingId.value), 'put');
}

function destroyItem(item: { id: number }) {
    router.delete(route('admin.{resources}.destroy', item.id), { preserveScroll: true });
}
</script>

<template>
    <Head title="Administration — {Resources}" />
    <AuthenticatedLayout>
        <template #header>
            <AdminSubnav />
        </template>

        <div class="space-y-6 p-6">
            <FlashMessages />

            <PageHeader title="{Label}" description="Gérez les {resources} du système.">
                <template #actions>
                    <Button @click="openCreate">Nouveau {resource}</Button>
                </template>
            </PageHeader>

            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>Nom</TableHead>
                        <TableHead class="w-24">Actions</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    <TableRow v-for="item in items" :key="item.id">
                        <TableCell>{{ item.name }}</TableCell>
                        <TableCell class="flex gap-2">
                            <Button variant="outline" size="sm" @click="openEdit(item.id, item)">
                                Éditer
                            </Button>
                            <ConfirmActionDialog
                                :title="`Supprimer ${item.name} ?`"
                                description="Cette action est irréversible."
                                @confirm="destroyItem(item)"
                            />
                        </TableCell>
                    </TableRow>
                </TableBody>
            </Table>
        </div>

        <Drawer v-model:open="drawerOpen" :title="editingId ? 'Modifier' : 'Créer'">
            <form class="space-y-4" @submit.prevent="editingId ? submitEdit() : submitCreate()">
                <FormField label="Nom" :error="form.errors.name" required>
                    <Input v-model="form.name" />
                </FormField>
                <LoadingButton type="submit" :loading="form.processing" class="w-full">
                    {{ editingId ? 'Enregistrer' : 'Créer' }}
                </LoadingButton>
            </form>
        </Drawer>
    </AuthenticatedLayout>
</template>
```

